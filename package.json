{
  "name": "wecom-workbench-h5-template",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:visual": "node --test tests/tooling/*.test.mjs && playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@wecom/jssdk": "^2.4.4",
    "alova": "^3.5.5",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.3",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14.0",
    "sass-embedded": "^1.108.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
